# JSON access logs on stdout. Caddy already masks Authorization and Cookie; these filters also
# drop them, Set-Cookie, Referer (a page URL can hold a reset token), and the one-time tokens
# query strings and screen capabilities the app carries in URLs.
(access_log) {
	log {
		output stdout
		format filter {
			wrap json
			request>headers>Authorization delete
			request>headers>Proxy-Authorization delete
			request>headers>Cookie delete
			request>headers>Referer delete
			resp_headers>Set-Cookie delete
			# Native sign-in redirects carry the session cookie in the app callback URL.
			resp_headers>Location delete
			request>uri regexp "(/reset-password/|/novnc/session/[a-z]+/)[^/?#&]*|\?.*" "${1}REDACTED"
		}
	}
}

(deploy_retry) {
	lb_try_duration 10s
	lb_try_interval 250ms
}

{$RAKAZO_HOST:app.example.com} {
	import access_log
	encode zstd gzip

	# A localhost trial must not pin HTTPS onto every local dev server.
	@hsts not host localhost 127.0.0.1
	header @hsts Strict-Transport-Security "max-age=31536000"
	# SAMEORIGIN still lets the app frame its own /novnc/ screen.
	header {
		X-Content-Type-Options nosniff
	}
	@frameRestricted not path /wuying/sdk/ASP/container.html
	header @frameRestricted X-Frame-Options SAMEORIGIN

	@health path /health /ready
	handle @health {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	handle /api/* {
		reverse_proxy api:3100 {
			import deploy_retry
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle /rpc/* {
		reverse_proxy api:3100 {
			import deploy_retry
			header_up X-Forwarded-For {client_ip}
		}
	}

	@appAssociation path /.well-known/apple-app-site-association /.well-known/assetlinks.json
	handle @appAssociation {
		reverse_proxy api:3100 {
			import deploy_retry
		}
	}

	handle /integrations/callback {
		reverse_proxy {$SYDNEY_INTEGRATION_CALLBACK_UPSTREAM:api:3100} {
			import deploy_retry
		}
	}

	handle /sign-in {
		reverse_proxy {$SYDNEY_SIGN_IN_UPSTREAM:api:3100} {
			import deploy_retry
		}
	}

	handle /novnc/* {
		reverse_proxy {$SYDNEY_SCREEN_PROXY_UPSTREAM:api:3100} {
			import deploy_retry
		}
	}

	handle /wuying/* {
		reverse_proxy {$SYDNEY_WUYING_SCREEN_UPSTREAM:api:3100} {
			import deploy_retry
		}
	}

	handle {
		respond 404
	}
}
