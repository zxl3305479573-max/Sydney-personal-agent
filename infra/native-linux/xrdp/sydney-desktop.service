[Unit]
Description=Sydney dedicated XFCE desktop session
Requires=sydney-display.service
After=sydney-display.service
PartOf=sydney-display.service

[Service]
User=sydney-desktop
Group=sydney-desktop
WorkingDirectory=/home/sydney-desktop
Environment=HOME=/home/sydney-desktop
Environment=DISPLAY=:10
Environment=XAUTHORITY=/home/sydney-desktop/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/sydney-desktop
EnvironmentFile=-/etc/sydney/desktop-proxy.env
ExecStart=/usr/bin/dbus-run-session -- /usr/bin/xfce4-session
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sydney-desktop /run/sydney-desktop /tmp
PrivateTmp=no
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
