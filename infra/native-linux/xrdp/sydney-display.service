[Unit]
Description=Sydney dedicated XRDP-compatible X11 display
After=xrdp-sesman.service

[Service]
User=sydney-desktop
Group=sydney-desktop
WorkingDirectory=/home/sydney-desktop
Environment=HOME=/home/sydney-desktop
Environment=DISPLAY=:10
Environment=XAUTHORITY=/home/sydney-desktop/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/sydney-desktop
RuntimeDirectory=sydney-desktop
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/test -f /home/sydney-desktop/.Xauthority
ExecStartPre=/usr/bin/mkdir -p /home/sydney-desktop/.local/state/sydney
ExecStart=/usr/lib/xorg/Xorg :10 -config /etc/X11/xrdp/xorg.conf -noreset -nolisten tcp -auth /home/sydney-desktop/.Xauthority -logfile /home/sydney-desktop/.local/state/sydney/Xorg.10.log
ExecStartPost=/usr/bin/timeout 15 /bin/sh -c 'until /usr/bin/xdpyinfo >/dev/null 2>&1; do sleep 0.2; done'
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/sydney-desktop /run/xrdp/sockdir /tmp
PrivateTmp=no
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
