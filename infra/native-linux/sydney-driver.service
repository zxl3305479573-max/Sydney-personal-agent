[Unit]
Description=Sydney native desktop driver
Requires=sydney-display.service
After=sydney-display.service

[Service]
User=sydney-desktop
Group=sydney-desktop
Environment=SYDNEY_CONTROL_USER=sydney-control
Environment=SYDNEY_WORKSPACE_ROOT=/var/lib/sydney-desktop/workspaces
Environment=DISPLAY=:99
Environment=XAUTHORITY=/var/lib/sydney-desktop/.Xauthority
EnvironmentFile=-/etc/sydney/desktop-proxy.env
ExecStart=/usr/bin/python3 /opt/sydney/infra/native-linux/driver.py
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sydney-desktop
PrivateTmp=no
Restart=on-failure
