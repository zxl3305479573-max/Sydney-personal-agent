[Unit]
Description=Sydney read-only desktop VNC bridge
Requires=sydney-display.service
After=sydney-display.service

[Service]
User=sydney-desktop
Group=sydney-desktop
Environment=HOME=/var/lib/sydney-desktop
Environment=DISPLAY=:99
Environment=XAUTHORITY=/var/lib/sydney-desktop/.Xauthority
EnvironmentFile=-/etc/sydney/screen.env
ExecStart=/usr/bin/x11vnc -display ${DISPLAY} -auth ${XAUTHORITY} -localhost -viewonly -forever -shared -nopw -rfbport 5900 -listen 127.0.0.1
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/sydney-desktop
PrivateTmp=no
Restart=on-failure

[Install]
WantedBy=multi-user.target
