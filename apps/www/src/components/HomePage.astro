---
import BaseLayout from "../layouts/BaseLayout.astro";
import { fetchDesktopDownloads } from "../github";
import { DOCS_URL, IOS_SETUP_URL, RELEASES_URL, SITE_DESCRIPTION, SITE_NAME } from "../site";
import Button from "./Button.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";

const locale = Astro.currentLocale;
const language = locale === "zh" ? "zh-CN" : locale === "zh-tw" ? "zh-TW" : "en";
const copy = language === "zh-CN"
  ? {
      description: "用同一个个人 AI 助手处理对话、项目和云电脑任务。",
      windows: "下载 Windows 版",
      releases: "查看 Windows 发行版",
      iphone: "iPhone 安装指南",
      docs: "项目文档",
      brand: "品牌素材",
      nav: "主导航",
      skip: "跳到正文",
    }
  : language === "zh-TW"
    ? {
        description: "用同一個個人 AI 助手處理對話、專案和雲端電腦任務。",
        windows: "下載 Windows 版",
        releases: "查看 Windows 發行版",
        iphone: "iPhone 安裝指南",
        docs: "專案文件",
        brand: "品牌素材",
        nav: "主導覽",
        skip: "跳到正文",
      }
    : {
        description: SITE_DESCRIPTION,
        windows: "Download for Windows",
        releases: "View Windows releases",
        iphone: "iPhone setup guide",
        docs: "Project docs",
        brand: "Brand",
        nav: "Main navigation",
        skip: "Skip to content",
      };
const downloads = await fetchDesktopDownloads();
---

<BaseLayout description={copy.description} language={language} skipLabel={copy.skip}>
  <div class="container">
    <Header homeHref={Astro.url.pathname} docsLabel={copy.docs} brandLabel={copy.brand} navLabel={copy.nav} />
    <main id="main">
      <section class="hero">
        <img src="/brand/sydney-mark.png" width="96" height="96" alt="" />
        <h1>{SITE_NAME}</h1>
        <p>{copy.description}</p>
        <div class="hero__actions">
          <Button href={downloads.windows ?? RELEASES_URL}>
            {downloads.windows ? copy.windows : copy.releases}
          </Button>
          <Button href={IOS_SETUP_URL} variant="secondary">{copy.iphone}</Button>
          <Button href={DOCS_URL} variant="secondary">{copy.docs}</Button>
        </div>
      </section>
    </main>
    <Footer />
  </div>
</BaseLayout>
