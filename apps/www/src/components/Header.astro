---
import { BRAND_KIT_PATH } from "../brand";
import { DOCS_URL } from "../site";
import Logo from "./Logo.astro";

type Props = {
  homeHref?: string;
  docsLabel?: string;
  brandLabel?: string;
  navLabel?: string;
};

const {
  homeHref = "/",
  docsLabel = "Docs",
  brandLabel = "Brand",
  navLabel = "Main navigation",
} = Astro.props;
---

<header class="site-header">
  <Logo href={homeHref} />
  <nav class="site-nav" aria-label={navLabel}>
    <a href={DOCS_URL}>{docsLabel}</a>
    <a href={BRAND_KIT_PATH} aria-current={Astro.url.pathname === BRAND_KIT_PATH ? "page" : undefined}>
      {brandLabel}
    </a>
  </nav>
</header>
